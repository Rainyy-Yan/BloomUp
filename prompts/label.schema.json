{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate model annotation, not human verified",
  "type": "object",
  "additionalProperties": false,
  "required": ["turn_id", "label", "evidence", "reason", "outsourcing", "insufficient_evidence", "self_reported_confidence"],
  "allOf": [
    {
      "if": {"properties": {"label": {"type": "null"}}},
      "then": {"properties": {"insufficient_evidence": {"const": true}}},
      "else": {"properties": {"insufficient_evidence": {"const": false}, "evidence": {"minLength": 1}}}
    }
  ],
  "properties": {
    "turn_id": {"type": "string", "minLength": 1},
    "label": {"type": ["integer", "null"], "minimum": 1, "maximum": 6},
    "evidence": {"type": "string"},
    "reason": {"type": "string", "minLength": 1},
    "outsourcing": {"enum": ["yes", "no", "uncertain"]},
    "insufficient_evidence": {"type": "boolean"},
    "self_reported_confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
