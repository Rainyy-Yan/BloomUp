# Source files supplied outside the repository
*.xlsx
*.xls
*.docx
*.doc

# All local research data, including future exports and human labels.
# Keep only a placeholder so a fresh clone has the data directory.
/data/*
!/data/.gitkeep

# Quarantine all scripts and research notes until each file is reviewed.
# Comments alone do not stop Git from staging files.
/tools/*
!/tools/prepare_qa_text.py
!/tools/build_student_mapping.py
!/tools/error_propagation.py
!/tools/__init__.py
!/tools/label_noise.py
/notes/*
/reproducibility/
/papers/*
!/papers/research-draft.md
/roadshow/
/Txxx_BloomUp/
/tmp/

# Manual annotation dictionaries are research data even though stored in Python.
/tools/apply_annotations.py
/tools/apply_annotations_v2.py
/tools/apply_annotations_turn.py

# Notes containing real question excerpts or record-level labels.
/notes/annotation_prompt_design.md
/notes/api_dependency.md
/notes/annotation_methodology_update.md
/notes/annotation_methodology_v2.md
/notes/turn_level_methodology.md

# Local environments, secrets, and generated files
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.env
.env.local
*.gpg

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Offline workflow state and local machine configuration; never publish research data.
/.local/
/local_state/
/runs/
/artifacts/
/workspaces/
/jobs/
/inference/
/exports/
/synthetic_demo/
/latest_run.json
/latest_workflow.json
/configs/*.local.json
/.repo_memory/
/.memorax-code/
/.firecrawl/
/outputs/
/.ci-state/
.env.*
!.env.example
*.csv
!data/.gitkeep
*.jsonl
*.log
*.key
*.pem
*.sqlite*
*.zip

# Only reviewed method documents are shared, never generated study reports.
/docs/*
!/docs/标注手册_v1.md
!/docs/workflow.md
!/docs/integration.md
!/docs/aiv-mathematics.md
!/docs/causal-b.md
!/docs/causal-b-architecture.md
